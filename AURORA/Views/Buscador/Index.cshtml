@model List<AURORA.Servicios.LibroExterno>
@{
    ViewData["Title"] = "Buscar Libros";
}

<style>
    /* ─── Tokens de paleta AURORA ─────────────────────────────── */
    :root {
        --ivory: #f7f3ec;
        --ivory-warm: #efe9de;
        --ivory-deep: #e6ddd0;
        --cream: #faf8f4;
        --ink: #1c1814;
        --ink-soft: #3d352c;
        --ink-muted: #7a6e63;
        --ink-ghost: #b0a498;
        --terra: #b85c38;
        --terra-light: #d4795a;
        --terra-pale: rgba(184,92,56,0.10);
        --terra-glow: rgba(184,92,56,0.22);
        --sage: #6b8c6e;
        --sage-pale: rgba(107,140,110,0.12);
        --border: rgba(28,24,20,0.10);
        --border-warm: rgba(184,92,56,0.18);
        --surface: #ffffff;
        --radius: 12px;
        --radius-sm: 8px;
        --shadow-sm: 0 2px 10px rgba(28,24,20,0.07);
        --shadow-md: 0 8px 32px rgba(28,24,20,0.10);
        --ease: cubic-bezier(0.22, 1, 0.36, 1);
    }

    /* ─── Layout principal ────────────────────────────────────── */
    .buscador-wrap {
        max-width: 980px;
        margin: 0 auto;
        padding: 2.5rem 1.25rem 4rem;
    }

    /* ─── Encabezado ──────────────────────────────────────────── */
    .buscador-header {
        margin-bottom: 2rem;
    }

    .buscador-eyebrow {
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .14em;
        text-transform: uppercase;
        color: var(--terra);
        margin-bottom: .4rem;
    }

    .buscador-titulo {
        font-size: 1.75rem;
        font-weight: 800;
        color: var(--ink);
        line-height: 1.2;
        margin: 0 0 .35rem;
    }

    .buscador-subtitulo {
        font-size: .875rem;
        color: var(--ink-muted);
        margin: 0;
    }

    /* ─── Barra de búsqueda ───────────────────────────────────── */
    .buscador-form {
        display: flex;
        gap: .6rem;
        margin-bottom: 2rem;
        background: var(--surface);
        border: 1.5px solid var(--border);
        border-radius: var(--radius);
        padding: .45rem .45rem .45rem .9rem;
        box-shadow: var(--shadow-sm);
        transition: border-color .2s var(--ease), box-shadow .2s var(--ease);
    }

        .buscador-form:focus-within {
            border-color: var(--terra);
            box-shadow: 0 0 0 3px var(--terra-pale), var(--shadow-sm);
        }

    .buscador-input {
        flex: 1;
        border: none;
        background: transparent;
        color: var(--ink);
        font-size: .95rem;
        padding: .35rem 0;
        outline: none;
        min-width: 0;
    }

        .buscador-input::placeholder {
            color: var(--ink-ghost);
        }

    .buscador-btn {
        padding: .55rem 1.4rem;
        border-radius: calc(var(--radius) - 4px);
        border: none;
        background: var(--terra);
        color: #fff;
        font-weight: 700;
        font-size: .875rem;
        cursor: pointer;
        letter-spacing: .02em;
        transition: background .18s var(--ease), transform .12s var(--ease);
        white-space: nowrap;
    }

        .buscador-btn:hover {
            background: var(--terra-light);
        }

        .buscador-btn:active {
            transform: scale(.97);
        }

    /* ─── Contador de resultados ──────────────────────────────── */
    .resultado-count {
        font-size: .82rem;
        color: var(--ink-muted);
        margin-bottom: 1.25rem;
    }

        .resultado-count strong {
            color: var(--ink-soft);
        }

    /* ─── Grid de tarjetas ────────────────────────────────────── */
    .buscador-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 1.1rem;
    }

    /* ─── Tarjeta ─────────────────────────────────────────────── */
    .libro-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        box-shadow: var(--shadow-sm);
        transition: transform .22s var(--ease), box-shadow .22s var(--ease), border-color .2s;
    }

        .libro-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-md);
            border-color: var(--border-warm);
        }

    /* Portada */
    .libro-portada {
        width: 100%;
        height: 165px;
        object-fit: cover;
        background: var(--ivory-warm);
        display: block;
    }

    .libro-portada-placeholder {
        width: 100%;
        height: 165px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--ivory-warm);
        font-size: 2.5rem;
    }

    /* Cuerpo */
    .libro-body {
        padding: .9rem 1rem 1rem;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: .3rem;
    }

    .libro-badges {
        display: flex;
        flex-wrap: wrap;
        gap: .3rem;
        margin-bottom: .25rem;
    }

    .libro-badge {
        display: inline-flex;
        align-items: center;
        gap: .2rem;
        padding: .12rem .5rem;
        border-radius: 20px;
        font-size: .68rem;
        font-weight: 700;
        letter-spacing: .02em;
        line-height: 1.6;
    }

    .badge-es {
        background: rgba(234,179,8,0.12);
        color: #92650a;
        border: 1px solid rgba(234,179,8,0.35);
    }

    .badge-lang {
        background: var(--ivory-deep);
        color: var(--ink-muted);
        border: 1px solid var(--border);
    }

    .badge-gutendex {
        background: var(--terra-pale);
        color: var(--terra);
        border: 1px solid var(--border-warm);
    }

    .badge-openlibrary {
        background: var(--sage-pale);
        color: var(--sage);
        border: 1px solid rgba(107,140,110,0.25);
    }

    .badge-advertencia {
        background: rgba(245,158,11,0.10);
        color: #92650a;
        border: 1px solid rgba(245,158,11,0.25);
    }

    .badge-formato {
        background: var(--ivory-warm);
        color: var(--ink-muted);
        border: 1px solid var(--border);
        font-weight: 600;
    }

    .libro-titulo {
        font-weight: 700;
        font-size: .9rem;
        line-height: 1.35;
        color: var(--ink);
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin-bottom: .1rem;
    }

    .libro-meta {
        font-size: .775rem;
        color: var(--ink-muted);
        margin: 0;
        display: flex;
        align-items: center;
        gap: .3rem;
    }

    /* ─── Botón importar ──────────────────────────────────────── */
    .btn-importar {
        margin-top: auto;
        width: 100%;
        padding: .55rem;
        border-radius: var(--radius-sm);
        border: 1.5px solid var(--border-warm);
        background: var(--ivory-warm);
        color: var(--terra);
        font-weight: 700;
        font-size: .82rem;
        cursor: pointer;
        letter-spacing: .02em;
        transition: background .18s var(--ease), color .18s, border-color .18s;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .4rem;
    }

        .btn-importar:hover:not(:disabled) {
            background: var(--terra);
            color: #fff;
            border-color: var(--terra);
        }

        .btn-importar:disabled {
            opacity: .45;
            cursor: not-allowed;
        }

    /* Spinner */
    .spinner {
        display: none;
        width: 14px;
        height: 14px;
        border: 2px solid rgba(255,255,255,0.4);
        border-top-color: currentColor;
        border-radius: 50%;
        animation: spin .7s linear infinite;
        flex-shrink: 0;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    /* ─── Alertas ─────────────────────────────────────────────── */
    .alerta {
        padding: .85rem 1.1rem;
        border-radius: var(--radius-sm);
        margin-bottom: 1.25rem;
        font-size: .875rem;
        display: flex;
        align-items: center;
        gap: .6rem;
    }

    .alerta-exito {
        background: var(--sage-pale);
        border: 1px solid rgba(107,140,110,0.3);
        color: #3a5c3d;
    }

    .alerta-error {
        background: rgba(184,92,56,0.08);
        border: 1px solid var(--border-warm);
        color: var(--terra);
    }

    /* ─── Estado vacío ────────────────────────────────────────── */
    .sin-resultados {
        text-align: center;
        padding: 4rem 1.5rem;
        color: var(--ink-ghost);
    }

        .sin-resultados .sin-icono {
            font-size: 2.8rem;
            margin-bottom: 1rem;
            display: block;
            opacity: .5;
        }

        .sin-resultados p {
            font-size: .9rem;
            margin: .3rem 0;
            color: var(--ink-muted);
        }

        .sin-resultados strong {
            color: var(--ink-soft);
        }

        .sin-resultados .hint {
            font-size: .8rem;
            color: var(--ink-ghost);
            margin-top: .5rem;
        }

    /* ─── Overlay de carga ────────────────────────────────────── */
    .cargando-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(28,24,20,0.55);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        z-index: 9999;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1.2rem;
    }

        .cargando-overlay.activo {
            display: flex;
        }

    .overlay-card {
        background: var(--surface);
        border: 1px solid var(--border-warm);
        border-radius: var(--radius);
        padding: 2rem 2.5rem;
        text-align: center;
        box-shadow: var(--shadow-md);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        min-width: 260px;
    }

    .overlay-spinner {
        width: 40px;
        height: 40px;
        border: 3px solid var(--ivory-deep);
        border-top-color: var(--terra);
        border-radius: 50%;
        animation: spin .8s linear infinite;
    }

    .overlay-titulo {
        font-size: 1rem;
        font-weight: 700;
        color: var(--ink);
        margin: 0;
    }

    .overlay-msg {
        font-size: .85rem;
        color: var(--ink-muted);
        margin: 0;
        min-height: 1.2em;
        transition: opacity .3s;
    }

    /* ─── Responsive ──────────────────────────────────────────── */
    @@media (max-width: 480px) {
        .buscador-grid {
            grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        }

        .buscador-titulo {
            font-size: 1.4rem;
        }
    }
</style>

<!-- Overlay de carga al importar -->
<div class="cargando-overlay" id="overlayImportando">
    <div class="overlay-card">
        <div class="overlay-spinner"></div>
        <p class="overlay-titulo">Agregando libro…</p>
        <p class="overlay-msg" id="overlayMensaje">Descargando archivo</p>
    </div>
</div>

<div class="buscador-wrap">

    <div class="buscador-header">
        <p class="buscador-eyebrow">Biblioteca abierta</p>
        <h2 class="buscador-titulo">Buscar libros</h2>
        <p class="buscador-subtitulo">Miles de títulos gratuitos de Project Gutenberg</p>
    </div>

    <!-- Alertas -->
    @if (TempData["Exito"] != null)
    {
        <div class="alerta alerta-exito">
            <span>✓</span>
            <span>@TempData["Exito"]</span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alerta alerta-error">
            <span>⚠</span>
            <span>@TempData["Error"]</span>
        </div>
    }

    <!-- Formulario de búsqueda -->
    <form method="post" action="/Buscador/Buscar" class="buscador-form">
        <input type="text" name="query" class="buscador-input"
               placeholder="Ej: Cervantes, Kafka, ciencia ficción…"
               value="@ViewBag.Query" required autocomplete="off" />
        <button type="submit" class="buscador-btn">Buscar</button>
    </form>

    <!-- Resultados -->
    @if (Model != null && Model.Any())
    {
        <p class="resultado-count">
            <strong>@Model.Count resultado(s)</strong> para "@ViewBag.Query"
        </p>

        <div class="buscador-grid">
            @foreach (var libro in Model)
            {
                <div class="libro-card">
                    <!-- Portada -->
                    @if (!string.IsNullOrEmpty(libro.Portada))
                    {
                        <img src="@libro.Portada"
                             class="libro-portada"
                             alt="Portada de @libro.Titulo"
                             onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
                        <div class="libro-portada-placeholder" style="display:none">📖</div>
                    }
                    else
                    {
                        <div class="libro-portada-placeholder">📖</div>
                    }

                    <div class="libro-body">
                        <!-- Badges -->
                        <div class="libro-badges">
                            @if (libro.Idioma == "es")
                            {
                                <span class="libro-badge badge-es">🇪🇸 Español</span>
                            }
                            else
                            {
                                <span class="libro-badge badge-lang">🌐 @libro.Idioma.ToUpper()</span>
                            }
                            <span class="libro-badge @(libro.Fuente == "Gutenberg" ? "badge-gutendex" : "badge-openlibrary")">
                                @libro.Fuente
                            </span>
                            <span class="libro-badge badge-formato">@libro.Formato.ToUpper()</span>
                            @if (libro.Fuente == "Open Library")
                            {
                                <span class="libro-badge badge-advertencia">⚠ variable</span>
                            }
                        </div>

                        <p class="libro-titulo">@libro.Titulo</p>
                        <p class="libro-meta">✍️ @libro.Autor</p>
                        <p class="libro-meta">📚 @libro.Genero</p>

                        <!-- Botón importar -->
                        <form method="post"
                              action="/Buscador/ImportarLibro"
                              style="margin-top:.75rem"
                              onsubmit="mostrarCargando(this)">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="titulo" value="@libro.Titulo" />
                            <input type="hidden" name="autor" value="@libro.Autor" />
                            <input type="hidden" name="urlDescarga" value="@libro.UrlDescarga" />
                            <input type="hidden" name="genero" value="@libro.Genero" />
                            <input type="hidden" name="formato" value="@libro.Formato" />

                            <button type="submit" class="btn-importar">
                                <span class="btn-texto">➕ Agregar a mi biblioteca</span>
                                <div class="spinner"></div>
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
    else if (ViewBag.Query != null)
    {
        <div class="sin-resultados">
            <span class="sin-icono">🔍</span>
            <p>No se encontraron libros descargables para <strong>"@ViewBag.Query"</strong>.</p>
            <p class="hint">Intenta con otro término o busca en inglés.</p>
        </div>
    }
    else
    {
        <div class="sin-resultados">
            <span class="sin-icono">📚</span>
            <p>Busca títulos gratuitos de <strong>Project Gutenberg</strong>.</p>
            <p class="hint">Prueba con un autor, título o género.</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        function mostrarCargando(form) {
            document.querySelectorAll('.btn-importar').forEach(b => b.disabled = true);

            const btn = form.querySelector('.btn-importar');
            btn.querySelector('.btn-texto').style.display = 'none';
            btn.querySelector('.spinner').style.display = 'block';

            document.getElementById('overlayImportando').classList.add('activo');

            const mensajes = [
                'Descargando archivo…',
                'Procesando páginas…',
                'Subiendo a tu biblioteca…',
                'Casi listo…'
            ];
            let i = 0;
            const el = document.getElementById('overlayMensaje');
            setInterval(() => { el.textContent = mensajes[i++ % mensajes.length]; }, 2500);
        }
    </script>
}