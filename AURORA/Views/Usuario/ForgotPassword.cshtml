@{
    ViewData["Title"] = "Recuperar contraseña";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — AURORA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@@0,400;0,700;1,400&family=Jost:wght@@200;300;400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/auth-flow.css" asp-append-version="true" />
</head>
<body>
    <main class="af-wrapper">
        <div class="af-card">
            <a href="/Usuario/Login" class="af-logo">AURORA</a>

            <div class="af-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                    <polyline points="22,6 12,13 2,6" />
                </svg>
            </div>

            <div class="af-header">
                <p class="af-eyebrow">Recuperación de cuenta</p>
                <h1 class="af-title">Recuperar contraseña</h1>
                <p class="af-sub">Ingresa tu correo y te enviaremos un código de verificación.</p>
            </div>

            @if (TempData["Mensaje"] != null)
            {
                <div class="af-alert af-alert--ok">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="15"><path d="M22 11.08V12a10 10 0 11-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
                    @TempData["Mensaje"]
                </div>
            }

            <form asp-action="ForgotPassword" method="post" id="forgotForm" novalidate>
                <div class="af-field">
                    <label class="af-label" for="email">Correo electrónico</label>
                    <input class="af-input" type="email" name="email" id="email"
                           placeholder="tu@@correo.com" required maxlength="50" autocomplete="email" />
                    <span class="af-warn" id="warnEmail" style="display:none">
                        El usuario debe tener máximo 45 caracteres antes del dominio.
                    </span>
                </div>

                <button type="submit" class="af-btn">
                    Enviar código
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="15"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
                </button>
            </form>

            <a href="/Usuario/Login" class="af-back">← Volver al inicio de sesión</a>
        </div>
    </main>
    <script>
            const emailInput = document.getElementById('email');
            const warnEmail  = document.getElementById('warnEmail');
            emailInput.addEventListener('input', () => {
                warnEmail.style.display = emailInput.value.length >= 45 ? 'block' : 'none';
            });
            document.getElementById('forgotForm').addEventListener('keypress', e => {
                if (e.key === 'Enter') { e.preventDefault(); e.currentTarget.submit(); }
            });
    </script>
</body>
</html>