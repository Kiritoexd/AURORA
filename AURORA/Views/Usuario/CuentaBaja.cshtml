@{
    ViewData["Title"] = "Cuenta desactivada";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cuenta desactivada · AURORA</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <style>
            *, *::before, *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            :root {
                --ivory: #f7f3ec;
                --ivory-warm: #efe9de;
                --ink: #1c1814;
                --ink-muted: #7a6e63;
                --ink-ghost: #b0a498;
                --terra: #b85c38;
                --terra-light: #d4795a;
                --terra-pale: rgba(184,92,56,0.10);
                --border: rgba(28,24,20,0.10);
                --border-warm: rgba(184,92,56,0.18);
                --radius: 14px;
                --radius-sm: 8px;
                --ease: cubic-bezier(0.22,1,0.36,1);
            }

            body {
                min-height: 100svh;
                display: flex;
                align-items: center;
                justify-content: center;
                background: var(--ivory);
                font-family: 'Inter', system-ui, sans-serif;
                padding: 1.5rem;
            }

            .card {
                background: #fff;
                border: 1px solid var(--border);
                border-radius: var(--radius);
                box-shadow: 0 8px 40px rgba(28,24,20,0.09);
                width: 100%;
                max-width: 400px;
                overflow: hidden;
            }

            .card__strip {
                height: 4px;
                background: linear-gradient(90deg, var(--terra), var(--terra-light));
            }

            .card__body {
                padding: 2.25rem 2rem 2rem;
                display: flex;
                flex-direction: column;
                align-items: center;
                text-align: center;
            }

            .card__icon {
                width: 56px;
                height: 56px;
                background: var(--terra-pale);
                border: 1px solid var(--border-warm);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                margin-bottom: 1.25rem;
                color: var(--terra);
            }

                .card__icon svg {
                    width: 26px;
                    height: 26px;
                }

            .card__brand {
                font-family: 'Playfair Display', serif;
                font-size: 0.7rem;
                font-weight: 700;
                letter-spacing: 0.2em;
                text-transform: uppercase;
                color: var(--ink-ghost);
                margin-bottom: 0.5rem;
            }

            h1 {
                font-family: 'Playfair Display', serif;
                font-size: 1.4rem;
                font-weight: 700;
                color: var(--ink);
                margin-bottom: 0.5rem;
                line-height: 1.2;
            }

            .card__desc {
                font-size: 0.875rem;
                color: var(--ink-muted);
                line-height: 1.6;
                margin-bottom: 1.75rem;
            }

            .divider {
                width: 100%;
                height: 1px;
                background: var(--border);
                margin-bottom: 1.5rem;
            }

            .info-box {
                width: 100%;
                background: var(--ivory-warm);
                border: 1px solid var(--border);
                border-radius: var(--radius-sm);
                padding: 0.875rem 1rem;
                margin-bottom: 1.5rem;
            }

            .info-box__label {
                font-size: 0.68rem;
                text-transform: uppercase;
                letter-spacing: 0.12em;
                color: var(--ink-ghost);
                margin-bottom: 0.3rem;
            }

            .info-box__text {
                font-size: 0.82rem;
                color: var(--ink-muted);
                line-height: 1.5;
            }

            .btn-volver {
                display: inline-flex;
                align-items: center;
                gap: 0.4rem;
                padding: 0.65rem 1.5rem;
                font-size: 0.875rem;
                font-weight: 600;
                font-family: 'Inter', sans-serif;
                color: var(--ivory);
                background: var(--terra);
                border: none;
                border-radius: var(--radius-sm);
                text-decoration: none;
                cursor: pointer;
                transition: background 0.2s var(--ease);
                margin-bottom: 1rem;
            }

                .btn-volver:hover {
                    background: var(--terra-light);
                }

            .footer-note {
                font-size: 0.75rem;
                color: var(--ink-ghost);
            }
    </style>
</head>
<body>

    <div class="card">
        <div class="card__strip"></div>
        <div class="card__body">

            <div class="card__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                     stroke-linecap="round" stroke-linejoin="round">
                    <rect x="5" y="11" width="14" height="10" rx="2" />
                    <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                    <line x1="12" y1="15" x2="12" y2="17" />
                </svg>
            </div>

            <p class="card__brand">AURORA</p>
            <h1>Cuenta desactivada</h1>
            <p class="card__desc">Un administrador ha desactivado tu cuenta. Si crees que es un error, contacta con el soporte.</p>

            <div class="divider"></div>
            <div class="info-box">
                <p class="info-box__label">¿Qué puedes hacer?</p>
                <p class="info-box__text">Escríbenos a <strong>auroraappoficial&#64;gmail.com</strong> indicando tu correo registrado y revisaremos tu caso a la brevedad.</p>
            </div>

            <a asp-controller="Usuario" asp-action="Login" class="btn-volver">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12" />
                    <polyline points="12 19 5 12 12 5" />
                </svg>
                Volver al inicio
            </a>

            <p class="footer-note">AURORA — Plataforma de lectura</p>
        </div>
    </div>

</body>
</html>