@{
    Layout = null;
    var mensaje = TempData["Mensaje"] as string;
    var error = TempData["Error"] as string;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar sesión — AURORA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@@0,400;0,700;1,400&family=Jost:wght@@200;300;400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>

    <div class="shell">

        <aside class="side" aria-hidden="true">
            <div class="side-inner">
                <div class="side-orb side-orb--1"></div>
                <div class="side-orb side-orb--2"></div>
                <div class="side-brand">
                    <span class="side-wordmark">AURORA</span>
                    <p class="side-tagline">Tu biblioteca digital</p>
                </div>
                <div class="side-lines" aria-hidden="true">
                    <div class="sl sl--1"></div>
                    <div class="sl sl--2"></div>
                    <div class="sl sl--3"></div>
                    <div class="sl sl--4"></div>
                    <div class="sl sl--5"></div>
                </div>
                <div class="side-chip side-chip--1">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="14"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12" /></svg>
                    <span>72% leído</span>
                </div>
                <div class="side-chip side-chip--2">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="14"><path d="M13 2L4.5 13.5H11L10 22l8.5-11.5H13L14 2z" /></svg>
                    <span>Racha de 7 días</span>
                </div>
            </div>
        </aside>

        <main class="main">
            <div class="card" id="loginCard">

                <div class="card-brand-mobile">
                    <a href="/" class="brand-link">AURORA</a>
                </div>

                <div class="card-header">
                    <p class="card-eyebrow">Bienvenido de vuelta</p>
                    <h1 class="card-title">Iniciar sesión</h1>
                </div>

                @if (!string.IsNullOrEmpty(mensaje))
                {
                    <div class="alert alert--ok" role="status">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="15"><path d="M22 11.08V12a10 10 0 11-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
                        @mensaje
                    </div>
                }
                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="alert alert--err" role="alert">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="15"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                        @error
                    </div>
                }

                <form class="form" method="post" action="/Usuario/Login" id="loginForm" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="field" id="fieldCorreo">
                        <label class="field-label" for="correo">Correo electrónico</label>
                        <input class="field-input" type="email" id="correo" name="Email"
                               placeholder="tu@@correo.com" autocomplete="email"
                               maxlength="40" required />
                        <span class="field-warn" id="warnCorreo">Ingresa un correo válido.</span>
                    </div>

                    <div class="field" id="fieldPass">
                        <label class="field-label" for="password">Contraseña</label>
                        <div class="field-wrap">
                            <input class="field-input" type="password" id="password" name="Password"
                                   placeholder="••••••••" autocomplete="current-password"
                                   maxlength="20" required />
                            <button type="button" class="eye-btn" id="togglePwd" aria-label="Mostrar contraseña">
                                <svg id="iconEyeOff" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94" />
                                    <path d="M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19" />
                                    <line x1="1" y1="1" x2="23" y2="23" />
                                </svg>
                                <svg id="iconEye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="display:none">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                            </button>
                        </div>
                        <span class="field-warn" id="warnPassword">Ingresa tu contraseña.</span>
                    </div>

                    <!-- Botón que SOLO valida campos y abre el captcha, NO hace submit -->
                    <button type="button" class="btn btn--primary" id="btnAbrirCaptcha">
                        Iniciar sesión
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="15"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
                    </button>

                </form>

                <div class="card-links">
                    <a class="card-link" href="/Usuario/ForgotPassword">¿Olvidaste tu contraseña?</a>
                    <span class="card-sep">·</span>
                    <a class="card-link card-link--accent" href="/Usuario/Registro">Crear cuenta</a>
                </div>

            </div>
        </main>
    </div>

    <!-- CAPTCHA OVERLAY -->
    <div class="captcha-overlay" id="captchaOverlay" role="dialog" aria-modal="true" aria-labelledby="captchaTitle">
        <div class="captcha-card">

            <div class="captcha-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                    <path d="M7 11V7a5 5 0 0110 0v4" />
                </svg>
            </div>

            <h2 class="captcha-title" id="captchaTitle">Verificación rápida</h2>
            <p class="captcha-sub">Resuelve el cálculo para continuar.</p>

            <div class="captcha-eq" id="captchaQuestion" aria-live="polite"></div>

            <div class="field">
                <label class="field-label" for="captchaInput">Tu respuesta</label>
                <input class="field-input field-input--center" type="text"
                       id="captchaInput" placeholder="?" autocomplete="off"
                       inputmode="numeric" maxlength="2" />
                <span class="field-warn field-warn--err" id="captchaError" role="alert"></span>
            </div>

            <div class="captcha-actions">
                <button type="button" class="btn btn--ghost" id="btnCaptchaCancel">Cancelar</button>
                <button type="button" class="btn btn--primary" id="btnCaptchaOk">Confirmar</button>
            </div>
        </div>
    </div>

    <script>
            (function () {
                'use strict';

                /* ── Toggle contraseña ── */
                const togglePwd = document.getElementById('togglePwd');
                const pwdInput  = document.getElementById('password');
                const iconOn    = document.getElementById('iconEye');
                const iconOff   = document.getElementById('iconEyeOff');

                togglePwd.addEventListener('click', function () {
                    const show = pwdInput.type === 'password';
                    pwdInput.type         = show ? 'text'     : 'password';
                    iconOn.style.display  = show ? 'block'    : 'none';
                    iconOff.style.display = show ? 'none'     : 'block';
                    this.setAttribute('aria-label', show ? 'Ocultar contraseña' : 'Mostrar contraseña');
                });

                /* ── Captcha ── */
                const a = Math.floor(Math.random() * 9) + 1;
                const b = Math.floor(Math.random() * 9) + 1;
                const captchaAnswer = a + b;
                document.getElementById('captchaQuestion').textContent = a + ' + ' + b + ' = ?';

                const overlay       = document.getElementById('captchaOverlay');
                const captchaInput  = document.getElementById('captchaInput');
                const captchaError  = document.getElementById('captchaError');
                const btnOk         = document.getElementById('btnCaptchaOk');
                const btnCancel     = document.getElementById('btnCaptchaCancel');
                const btnAbrirCaptcha = document.getElementById('btnAbrirCaptcha');
                const btnSubmit     = document.getElementById('btnSubmit');
                const form          = document.getElementById('loginForm');
                const correoInput   = document.getElementById('correo');
                const warnCorreo    = document.getElementById('warnCorreo');
                const warnPass      = document.getElementById('warnPassword');

                /* ── Captcha input: solo dígitos ── */
                captchaInput.addEventListener('keydown', function (e) {
                    const controlKeys = ['Backspace','Delete','ArrowLeft','ArrowRight','Tab','Enter','Home','End'];
                    if (controlKeys.includes(e.key)) return;
                    if (!/^\d$/.test(e.key)) { e.preventDefault(); return; }
                    if (this.value.replace(/\D/g,'').length >= 2) e.preventDefault();
                });
                captchaInput.addEventListener('input', function () {
                    const cleaned = this.value.replace(/\D/g, '').slice(0, 2);
                    if (this.value !== cleaned) this.value = cleaned;
                });
                captchaInput.addEventListener('paste', function (e) {
                    e.preventDefault();
                    const pasted = (e.clipboardData || window.clipboardData).getData('text');
                    this.value = pasted.replace(/\D/g, '').slice(0, 2);
                });

                /* ── Validación formulario ── */
                function validate() {
                    let ok = true;
                    const emailRe = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

                    if (!emailRe.test(correoInput.value.trim())) {
                        correoInput.classList.add('input--error');
                        warnCorreo.classList.add('visible');
                        ok = false;
                    } else {
                        correoInput.classList.remove('input--error');
                        warnCorreo.classList.remove('visible');
                    }
                    if (pwdInput.value.trim() === '') {
                        pwdInput.classList.add('input--error');
                        warnPass.classList.add('visible');
                        ok = false;
                    } else {
                        pwdInput.classList.remove('input--error');
                        warnPass.classList.remove('visible');
                    }
                    return ok;
                }

                /* ── Abrir / cerrar captcha ── */
                function showCaptcha() {
                    captchaInput.value = '';
                    captchaError.textContent = '';
                    captchaError.classList.remove('visible');
                    overlay.classList.add('active');
                    setTimeout(() => captchaInput.focus(), 60);
                }
                function hideCaptcha() { overlay.classList.remove('active'); }

                /* ── El botón visible solo valida y abre el captcha ── */
                btnAbrirCaptcha.addEventListener('click', function () {
                    if (validate()) showCaptcha();
                });

                /* ── Confirmar captcha → submit real ── */
                           btnOk.addEventListener('click', function () {
                const val = captchaInput.value.trim();
                if (val === '' || parseInt(val, 10) !== captchaAnswer) {
                    captchaError.textContent = 'Respuesta incorrecta, intenta de nuevo.';
                    captchaError.classList.add('visible');
                    captchaInput.value = '';
                    captchaInput.focus();
                    return;
                }
                hideCaptcha();
                btnAbrirCaptcha.disabled = true;
                btnAbrirCaptcha.textContent = 'Entrando…';
                form.submit(); // submit nativo, bypasea el event listener
            });
                captchaInput.addEventListener('keypress', function (e) {
                    if (e.key === 'Enter') { e.preventDefault(); btnOk.click(); }
                });

                btnCancel.addEventListener('click', hideCaptcha);

                correoInput.addEventListener('input', function () {
                    this.classList.remove('input--error');
                    warnCorreo.classList.remove('visible');
                });
                pwdInput.addEventListener('input', function () {
                    this.classList.remove('input--error');
                    warnPass.classList.remove('visible');
                });

                document.getElementById('loginCard').classList.add('card--in');
            })();
    </script>
</body>
</html>