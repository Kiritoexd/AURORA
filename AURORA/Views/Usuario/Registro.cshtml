@model AURORA.Models.Tb_Usuario
@{
    ViewData["Title"] = "Registro";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Crear cuenta — AURORA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@@0,400;0,700;1,400&family=Jost:wght@@200;300;400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/registro.css" asp-append-version="true" />
</head>
<body>

    <div class="shell">

        <!-- Panel lateral — solo desktop -->
        <aside class="side" aria-hidden="true">
            <div class="side-inner">
                <div class="side-orb side-orb--1"></div>
                <div class="side-orb side-orb--2"></div>

                <div class="side-brand">
                    <span class="side-wordmark">AURORA</span>
                    <p class="side-tagline">Tu biblioteca digital</p>
                </div>

                <div class="side-lines">
                    <div class="sl sl--1"></div>
                    <div class="sl sl--2"></div>
                    <div class="sl sl--3"></div>
                    <div class="sl sl--4"></div>
                    <div class="sl sl--5"></div>
                </div>

                <div class="side-chip side-chip--1">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="14">
                        <path d="M4 19V5a2 2 0 0 1 2-2h13a1 1 0 0 1 1 1v13" />
                        <path d="M4 19a2 2 0 0 0 2 2h13a1 1 0 0 0 1-1" />
                    </svg>
                    <span>Biblioteca personal</span>
                </div>
                <div class="side-chip side-chip--2">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="14">
                        <path d="M13 2L4.5 13.5H11L10 22l8.5-11.5H13L14 2z" />
                    </svg>
                    <span>Rachas de lectura</span>
                </div>
            </div>
        </aside>

        <!-- Formulario principal -->
        <main class="main">
            <div class="card" id="regCard">

                <!-- Logo solo móvil -->
                <div class="card-brand-mobile">
                    <a href="/" class="brand-link">AURORA</a>
                </div>

                <div class="card-header">
                    <p class="card-eyebrow">Empieza gratis</p>
                    <h1 class="card-title">Crear cuenta</h1>
                </div>

                <form asp-action="Registro" method="post" class="form" id="regForm" novalidate>
                    @Html.AntiForgeryToken()

                    <!-- Nombre -->
                    <div class="field">
                        <label class="field-label" for="Nombres">Nombre(s)</label>
                        <input asp-for="Nombres" id="Nombres" class="field-input"
                               placeholder="Tu nombre" autocomplete="given-name" maxlength="15" />
                        <span class="field-warn" id="warnNombres">Máximo 15 caracteres.</span>
                        <span asp-validation-for="Nombres" class="field-error"></span>
                    </div>

                    <!-- Apellidos en fila -->
                    <div class="row">
                        <div class="field">
                            <label class="field-label" for="ApellidoPaterno">Ap. paterno</label>
                            <input asp-for="ApellidoPaterno" id="ApellidoPaterno" class="field-input"
                                   placeholder="Paterno" autocomplete="family-name" maxlength="10" />
                            <span class="field-warn" id="warnPaterno">Máximo 10 caracteres.</span>
                            <span asp-validation-for="ApellidoPaterno" class="field-error"></span>
                        </div>
                        <div class="field">
                            <label class="field-label" for="ApellidoMaterno">Ap. materno</label>
                            <input asp-for="ApellidoMaterno" id="ApellidoMaterno" class="field-input"
                                   placeholder="Materno" maxlength="10" />
                            <span class="field-warn" id="warnMaterno">Máximo 10 caracteres.</span>
                            <span asp-validation-for="ApellidoMaterno" class="field-error"></span>
                        </div>
                    </div>

                    <!-- Correo -->
                    <div class="field">
                        <label class="field-label" for="Email">Correo electrónico</label>
                        <input asp-for="Email" id="Email" type="email" class="field-input"
                               placeholder="usuario@@correo.com" autocomplete="email" maxlength="40" />
                        <span class="field-warn" id="warnEmail">Máximo 40 caracteres.</span>
                        <span asp-validation-for="Email" class="field-error"></span>
                    </div>

                    <!-- Contraseña -->
                    <div class="field">
                        <label class="field-label" for="Password">Contraseña</label>
                        <div class="field-wrap">
                            <input asp-for="Password" id="Password" type="password"
                                   class="field-input" placeholder="••••••••"
                                   autocomplete="new-password" maxlength="20" />
                            <button type="button" class="eye-btn" id="togglePwd" aria-label="Mostrar contraseña">
                                <svg id="eyeOff" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94" />
                                    <path d="M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19" />
                                    <line x1="1" y1="1" x2="23" y2="23" />
                                </svg>
                                <svg id="eyeOn" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="display:none">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                            </button>
                        </div>
                        <span class="field-warn" id="warnPassword">Máximo 20 caracteres.</span>
                        <span asp-validation-for="Password" class="field-error"></span>
                    </div>

                    <input type="hidden" name="captchaRespuesta" id="captchaRespuesta" />

                    <!-- Botón verificación (antes del captcha) -->
                    <button type="button" id="btnCaptcha" class="btn btn--secondary">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="15">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                            <path d="M7 11V7a5 5 0 0110 0v4" />
                        </svg>
                        Verificación humana
                    </button>

                    <!-- Botón crear cuenta (después del captcha) -->
                    <button type="submit" id="btnRegistro" class="btn btn--primary btn--hidden">
                        Crear cuenta
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="15">
                            <path d="M5 12h14M12 5l7 7-7 7" />
                        </svg>
                    </button>
                </form>

                <div class="card-links">
                    <a class="card-link" asp-controller="Usuario" asp-action="Login">¿Ya tienes cuenta? Inicia sesión</a>
                </div>

            </div>
        </main>
    </div>

    <!-- CAPTCHA OVERLAY -->
    <div id="captchaModal" class="captcha-overlay" role="dialog" aria-modal="true" aria-labelledby="captchaTitle">
        <div class="captcha-card">

            <div class="captcha-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                    <path d="M7 11V7a5 5 0 0110 0v4" />
                </svg>
            </div>

            <h2 class="captcha-title" id="captchaTitle">Verificación rápida</h2>
            <p class="captcha-sub">Resuelve el cálculo para continuar.</p>

            <div class="captcha-eq" id="captchaPregunta" aria-live="polite"></div>

            <div class="field">
                <label class="field-label" for="captchaInput">Tu respuesta</label>
                <input type="text" id="captchaInput" class="field-input field-input--center"
                       placeholder="?" inputmode="numeric"
                       autocomplete="off" maxlength="2" />
                <span class="field-warn field-warn--err" id="captchaError" role="alert"></span>
            </div>

            <div class="captcha-actions">
                <button type="button" class="btn btn--ghost" id="btnCancelar">Cancelar</button>
                <button type="button" class="btn btn--primary" id="btnValidar">Confirmar</button>
            </div>
        </div>
    </div>

    <script>
            (function () {
                "use strict";

                /* ── Límites de caracteres ── */
                [
                    { id: "Nombres",         warn: "warnNombres",  max: 15 },
                    { id: "ApellidoPaterno", warn: "warnPaterno",  max: 10 },
                    { id: "ApellidoMaterno", warn: "warnMaterno",  max: 10 },
                    { id: "Email",           warn: "warnEmail",    max: 40 },
                    { id: "Password",        warn: "warnPassword", max: 20 }
                ].forEach(function(f) {
                    var el = document.getElementById(f.id);
                    var wn = document.getElementById(f.warn);
                    if (!el || !wn) return;
                    el.addEventListener("input", function() {
                        wn.classList.toggle("visible", el.value.length >= f.max);
                    });
                });

                /* ── Toggle contraseña ── */
                document.getElementById("togglePwd").addEventListener("click", function () {
                    var pwd  = document.getElementById("Password");
                    var on   = document.getElementById("eyeOn");
                    var off  = document.getElementById("eyeOff");
                    var show = pwd.type === "password";
                    pwd.type          = show ? "text"    : "password";
                    on.style.display  = show ? "block"   : "none";
                    off.style.display = show ? "none"    : "block";
                    this.setAttribute("aria-label", show ? "Ocultar contraseña" : "Mostrar contraseña");
                });

                /* ── Captcha ── */
                var a = Math.floor(Math.random() * 9) + 1;
                var b = Math.floor(Math.random() * 9) + 1;
                var respuesta = a + b;
                document.getElementById("captchaPregunta").textContent = a + " + " + b + " = ?";

                var modal      = document.getElementById("captchaModal");
                var inputC     = document.getElementById("captchaInput");
                var errorEl    = document.getElementById("captchaError");
                var btnCaptcha = document.getElementById("btnCaptcha");
                var btnRegistro= document.getElementById("btnRegistro");
                var btnCancelar= document.getElementById("btnCancelar");

                /* Solo dígitos, máx 2 — bloqueo en keydown, limpieza en input, bloqueo en paste */
                inputC.addEventListener("keydown", function (e) {
                    var ctrl = ["Backspace","Delete","ArrowLeft","ArrowRight","Tab","Enter","Home","End"];
                    if (ctrl.indexOf(e.key) !== -1) return;
                    if (!/^\d$/.test(e.key)) { e.preventDefault(); return; }
                    if (this.value.replace(/\D/g,"").length >= 2) e.preventDefault();
                });
                inputC.addEventListener("input", function () {
                    var cleaned = this.value.replace(/\D/g, "").slice(0, 2);
                    if (this.value !== cleaned) this.value = cleaned;
                });
                inputC.addEventListener("paste", function (e) {
                    e.preventDefault();
                    var pasted = (e.clipboardData || window.clipboardData).getData("text");
                    this.value = pasted.replace(/\D/g, "").slice(0, 2);
                });

                /* Abrir modal */
                btnCaptcha.addEventListener("click", function () {
                    inputC.value = "";
                    errorEl.textContent = "";
                    errorEl.classList.remove("visible");
                    modal.classList.add("active");
                    setTimeout(function() { inputC.focus(); }, 60);
                });

                /* Cerrar sin validar */
                btnCancelar.addEventListener("click", function () {
                    modal.classList.remove("active");
                });

                /* Validar */
                function validar() {
                    var val = inputC.value.trim();
                    if (val === "") {
                        errorEl.textContent = "Ingresa tu respuesta.";
                        errorEl.classList.add("visible");
                        return;
                    }
                    if (parseInt(val, 10) === respuesta) {
                        document.getElementById("captchaRespuesta").value = respuesta;
                        modal.classList.remove("active");
                        btnCaptcha.style.display  = "none";
                        btnRegistro.classList.remove("btn--hidden");
                        btnRegistro.style.display = "flex";
                    } else {
                        errorEl.textContent = "Respuesta incorrecta. Intenta de nuevo.";
                        errorEl.classList.add("visible");
                        inputC.value = "";
                        inputC.focus();
                    }
                }

                document.getElementById("btnValidar").addEventListener("click", validar);
                inputC.addEventListener("keypress", function (e) {
                    if (e.key === "Enter") { e.preventDefault(); validar(); }
                });

                /* Animación entrada */
                document.getElementById("regCard").classList.add("card--in");

            })();
    </script>

</body>
</html>
