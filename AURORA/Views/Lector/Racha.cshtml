@model AURORA.Models.RachaViewModel
@{
    ViewData["Title"] = "Mi Racha";
    bool esNuevo = ViewBag.EsNuevoRegistro == true;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;1,400&family=Figtree:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/Racha.css" asp-append-version="true" />

<!-- Partículas de celebración -->
<canvas id="celebCanvas" style="position:fixed;inset:0;pointer-events:none;z-index:999;display:none;"></canvas>

<div class="racha-wrapper">

    <!-- Hero -->
    <div class="racha-hero">
        <div class="racha-hero__left">
            <div class="racha-flame-wrap" id="flameWrap">
                <svg class="racha-flame" id="flamesvg" viewBox="0 0 64 80" fill="none">
                    <path d="M32 4C32 4 48 20 48 36C48 44.837 40.837 52 32 52C23.163 52 16 44.837 16 36C16 28 22 20 22 20C22 20 20 32 28 36C28 36 24 24 32 4Z" fill="url(#flameGrad)" />
                    <path d="M32 40C32 40 38 34 38 28C38 24 35 21 32 20C32 20 36 26 32 32C32 32 30 28 27 28C27 28 26 36 32 40Z" fill="url(#innerGrad)" />
                    <defs>
                        <linearGradient id="flameGrad" x1="32" y1="4" x2="32" y2="52" gradientUnits="userSpaceOnUse">
                            <stop offset="0%" stop-color="#d4795a" />
                            <stop offset="100%" stop-color="#b85c38" />
                        </linearGradient>
                        <linearGradient id="innerGrad" x1="32" y1="20" x2="32" y2="40" gradientUnits="userSpaceOnUse">
                            <stop offset="0%" stop-color="#efe9de" />
                            <stop offset="100%" stop-color="#d4795a" />
                        </linearGradient>
                    </defs>
                </svg>
                <div class="racha-glow-ring" id="glowRing"></div>
            </div>

            <div class="racha-hero__stat">
                <span class="racha-days-num" id="rachaNum">@Model.DiasSeguidos</span>
                <span class="racha-days-label">días seguidos</span>
            </div>
        </div>

        <div class="racha-hero__right">
            <p class="racha-message" id="rachaMsg">
                @if (Model.DiasSeguidos == 0)
                {
                    <span>Empieza hoy y enciende tu primera racha.</span>
                }
                else if (Model.DiasSeguidos < 7)
                {
                    <span>¡Buen comienzo! Sigue sumando días.</span>
                }
                else if (Model.DiasSeguidos < 30)
                {
                    <span>¡Estás en racha! No lo detengas.</span>
                }
                else
                {
                    <span>¡Disciplina lectora increíble!</span>
                }
            </p>

            <div class="racha-registered" id="rachaRegistered" style="display:none;">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12" />
                </svg>
                Lectura registrada hoy
            </div>

            @if (!esNuevo)
            {
                <!-- Ya registrado previamente, mostrar badge directo -->
                <script>document.addEventListener('DOMContentLoaded',()=>{ document.getElementById('rachaRegistered').style.display=''; });</script>
            }
        </div>
    </div>

    <!-- Progreso -->
    <div class="racha-progress-section">
        <div class="racha-progress-header">
            <span class="racha-progress-label">Meta de @Model.MetaDias días</span>
            <span class="racha-progress-fraction">@Model.DiasSeguidos / @Model.MetaDias</span>
        </div>
        <div class="racha-bar-track">
            <div class="racha-bar-fill" id="rachaFill"></div>
        </div>
        <p class="racha-remaining">
            @{
                var restantes = Model.MetaDias - Model.DiasSeguidos;
            }
            @if (restantes > 0)
            {
                <span>Faltan <strong>@restantes días</strong> para alcanzar tu meta</span>
            }
            else
            {
                <span>🎉 ¡Meta alcanzada! Sigue superándote.</span>
            }
        </p>
    </div>

    <!-- Logros -->
    <div class="racha-logros">
        <h2 class="racha-logros-title">Logros de racha</h2>
        <div class="racha-logros-grid">
            @foreach (var logro in Model.Logros)
            {
                <div class="logro-card @(logro.Desbloqueado ? "logro--on" : "logro--off")">
                    <div class="logro-icon">
                        @if (logro.Dias == 7)
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z" /></svg>
                        }
                        else if (logro.Dias == 15)
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
                        }
                        else if (logro.Dias == 30)
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="6" /><path d="M8 14l-4 7h16l-4-7" /></svg>
                        }
                        else if (logro.Dias == 60)
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M13 2L4.5 13.5H11L10 22l8.5-11.5H13L14 2z" /></svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" /></svg>
                        }
                    </div>
                    <div class="logro-info">
                        <span class="logro-nombre">@logro.Nombre</span>
                        <span class="logro-dias">@logro.Dias días</span>
                    </div>
                    @if (logro.Desbloqueado)
                    {
                        <span class="logro-badge">✓</span>
                    }
                    else
                    {
                        <span class="logro-lock">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                                <rect x="5" y="11" width="14" height="10" rx="2" />
                                <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                            </svg>
                        </span>
                    }
                </div>
            }
        </div>
    </div>

</div>

<script>
    const ES_NUEVO = @(esNuevo ? "true" : "false");
    const DIAS     = @Model.DiasSeguidos;
    const META     = @Model.MetaDias;

    document.addEventListener("DOMContentLoaded", () => {
    // Barra de progreso siempre
    const fill = document.getElementById("rachaFill");
    const pct  = Math.min((DIAS / META) * 100, 100);
    fill.style.width = "0%";
    setTimeout(() => { fill.style.width = pct + "%"; }, 200);

    if (!ES_NUEVO) return;

    // ── Secuencia de celebración ──────────────────────────────────
    const flameWrap = document.getElementById("flameWrap");
    const glowRing  = document.getElementById("glowRing");
    const numEl     = document.getElementById("rachaNum");
    const badge     = document.getElementById("rachaRegistered");

    // 1. Llama pulsa grande
    setTimeout(() => {
    flameWrap.classList.add("flame--celebrar");
    glowRing.classList.add("glow--celebrar");
    }, 300);

    // 2. Número hace pop
    setTimeout(() => {
    numEl.classList.add("num--pop");
    }, 600);

    // 3. Partículas
    setTimeout(() => {
    lanzarParticulas();
    }, 500);

    // 4. Badge aparece con slide
    setTimeout(() => {
    badge.style.display = "";
    badge.classList.add("badge--entrando");
    }, 900);

    // 5. Limpiar clases de animación
    setTimeout(() => {
    flameWrap.classList.remove("flame--celebrar");
    glowRing.classList.remove("glow--celebrar");
    numEl.classList.remove("num--pop");
    }, 1800);
    });

    // ── Canvas partículas estilo Duolingo ─────────────────────────────
    function lanzarParticulas() {
    const canvas = document.getElementById("celebCanvas");
    canvas.width  = window.innerWidth;
    canvas.height = window.innerHeight;
    canvas.style.display = "block";
    const ctx = canvas.getContext("2d");

    const colores = ["#b85c38","#d4795a","#6b8c6e","#F5C842","#efe9de","#b0a498"];
    const particulas = Array.from({ length: 90 }, () => ({
    x:  canvas.width  * (0.3 + Math.random() * 0.4),
    y:  canvas.height * 0.35,
    vx: (Math.random() - 0.5) * 9,
    vy: -(Math.random() * 10 + 4),
    r:  Math.random() * 6 + 3,
    color: colores[Math.floor(Math.random() * colores.length)],
    rot: Math.random() * 360,
    rotV: (Math.random() - 0.5) * 8,
    forma: Math.random() > 0.5 ? "rect" : "circle",
    alpha: 1
    }));

    let frame = 0;
    function animar() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    particulas.forEach(p => {
    p.x  += p.vx;
    p.y  += p.vy;
    p.vy += 0.35;          // gravedad
    p.vx *= 0.98;
    p.rot += p.rotV;
    p.alpha -= 0.013;

    if (p.alpha <= 0) return;
    ctx.save();
    ctx.globalAlpha = Math.max(p.alpha, 0);
    ctx.translate(p.x, p.y);
    ctx.rotate((p.rot * Math.PI) / 180);
    ctx.fillStyle = p.color;

    if (p.forma === "rect") {
    ctx.fillRect(-p.r, -p.r / 2, p.r * 2, p.r);
    } else {
    ctx.beginPath();
    ctx.arc(0, 0, p.r, 0, Math.PI * 2);
    ctx.fill();
    }
    ctx.restore();
    });

    frame++;
    if (frame < 120) requestAnimationFrame(animar);
    else canvas.style.display = "none";
    }
    animar();
    }
</script>

<style>
    /* ── Animaciones de celebración ─────────────────────────────────── */

    @@keyframes flamePulse {
    0% {
    transform: scale(1);
    }

    30% {
    transform: scale(1.45) rotate(-4deg);
    }

    55% {
    transform: scale(1.3) rotate(3deg);
    }

    75% {
    transform: scale(1.38) rotate(-2deg);
    }

    100% {
    transform: scale(1);
    }
    }

    @@keyframes glowBurst {
    0% {
    opacity: 0.4;
    transform: scale(1);
    }

    40% {
    opacity: 1;
    transform: scale(2.2);
    }

    100% {
    opacity: 0;
    transform: scale(3);
    }
    }

    @@keyframes numPop {
    0% {
    transform: scale(1);
    }

    40% {
    transform: scale(1.35);
    color: var(--terra);
    }

    70% {
    transform: scale(0.95);
    }

    100% {
    transform: scale(1);
    }
    }

    @@keyframes badgeSlide {
    from {
    opacity: 0;
    transform: translateY(10px);
    }

    to {
    opacity: 1;
    transform: translateY(0);
    }
    }

    .flame--celebrar .racha-flame {
    animation: flamePulse 0.9s cubic-bezier(0.22,1,0.36,1) forwards;
    }

    .glow--celebrar {
    animation: glowBurst 1s ease-out forwards !important;
    }

    .num--pop {
    display: inline-block;
    animation: numPop 0.6s cubic-bezier(0.22,1,0.36,1) forwards;
    }

    .badge--entrando {
    animation: badgeSlide 0.45s cubic-bezier(0.22,1,0.36,1) forwards;
    }
</style>
